# ===== Runtime =====
PORT=3000
TRUST_PROXY_HOPS=1
DATABASE_DIR=database
PUBLIC_BASE_URL=https://your-domain.com

# Optional admin bootstrap (recommended for first deploy / recovery)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123
ADMIN_BOOTSTRAP_FORCE_RESET=false

# ===== Booking Abuse Protection =====
BOOKING_IP_WINDOW_MS=600000
BOOKING_IP_MAX_REQUESTS=30
BOOKING_IP_MIN_INTERVAL_MS=15000
BOOKING_PHONE_WINDOW_MS=3600000
BOOKING_PHONE_MAX_REQUESTS=2
BOOKING_PHONE_MIN_INTERVAL_MS=30000
ALLOWED_PHONE_COUNTRIES=CA,US

# ===== CAPTCHA (Turnstile) =====
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ===== GoHighLevel (Hybrid flow: upsert contact + trigger workflow) =====
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_PRIVATE_TOKEN=your_private_integration_token
GHL_LOCATION_ID=your_location_id
GHL_BOOKING_WORKFLOW_ID=your_workflow_id
GHL_PAYMENT_WORKFLOW_ID=optional_payment_confirmation_workflow_id
GHL_REQUEST_TIMEOUT_MS=8000

# ===== Payment =====
PAYMENT_CURRENCY=CAD
ROOM_PRICE_SMALL=55
ROOM_PRICE_MEDIUM=65
ROOM_PRICE_VIP=85

# Stripe (leave blank to disable)
STRIPE_PUBLISHABLE_KEY=pk_test_51ExampleReplaceMe
STRIPE_SECRET_KEY=sk_test_51ExampleReplaceMe

# PayPal (leave blank to disable)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=AbcExampleClientIdReplaceMe
PAYPAL_CLIENT_SECRET=EfgExampleClientSecretReplaceMe
